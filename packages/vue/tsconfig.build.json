{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": false,
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "noEmit": false,
    "outDir": "../../temp/declarations/vue",
    "paths": {
      "@snap-motion/vue/carousel": ["./src/carousel/index.ts"],
      "@snap-motion/vue/dialog": ["./src/dialog/index.ts"],
      "@snap-motion/vue/localization": ["./src/localization/index.ts"],
      "@snap-motion/vue/motion": ["./src/motion/index.ts"]
    },
    "rootDir": "src",
    "types": []
  },
  "include": ["src/**/*.ts"],
  "exclude": ["test"]
}
