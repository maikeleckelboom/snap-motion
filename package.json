{
  "name": "snap-motion",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @snap-motion/lab dev",
    "architecture:check": "node scripts/check-architecture.mjs",
    "build": "pnpm build:packages && pnpm build:apps:prepared",
    "build:apps:prepared": "pnpm --filter @snap-motion/lab build && pnpm --filter @snap-motion/router-fixture build && pnpm --filter @snap-motion/nuxt-fixture build",
    "typecheck": "pnpm build:packages && pnpm typecheck:prepared",
    "typecheck:prepared": "pnpm typecheck:tooling && pnpm -r --if-present typecheck",
    "typecheck:tooling": "tsc -p scripts/tsconfig.json --noEmit",
    "lint": "oxlint . && pnpm architecture:check",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "test": "pnpm test:unit && pnpm test:e2e",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "visual:stacked-deck": "node scripts/runStackedDeckVisual.ts",
    "visual:stacked-deck:direct": "node scripts/runStackedDeckDirectVisual.ts",
    "visual:stacked-deck:compare": "node scripts/compareStackedDeckVisual.ts",
    "test:preview": "pnpm build:preview && pnpm test:preview:prepared",
    "test:preview:prepared": "playwright test --config playwright.preview.config.ts",
    "test:fixtures": "pnpm build:fixtures && pnpm test:fixtures:prepared",
    "test:fixtures:prepared": "playwright test --config playwright.fixtures.config.ts",
    "api:check": "pnpm build:packages && pnpm api:check:prepared",
    "api:check:prepared": "node scripts/run-api-extractor.mjs --mode=check",
    "api:update": "pnpm build:packages && node scripts/run-api-extractor.mjs --mode=update",
    "build:packages": "pnpm --filter @snap-motion/core build && pnpm --filter @snap-motion/vue build",
    "build:preview": "pnpm build:packages && pnpm build:preview:prepared",
    "build:preview:prepared": "pnpm --filter @snap-motion/lab build:preview",
    "build:fixtures": "pnpm build:packages && pnpm build:fixtures:prepared",
    "build:fixtures:prepared": "pnpm --filter @snap-motion/router-fixture build && pnpm --filter @snap-motion/nuxt-fixture build",
    "pack:packages": "node scripts/pack-packages.ts",
    "pack:packages:prepared": "node scripts/pack-packages.ts --prepared",
    "verify:packages": "pnpm build:packages && pnpm pack:packages:prepared && pnpm verify:packages:prepared",
    "verify:packages:prepared": "node scripts/verify-packages.ts",
    "verify:packages:browser": "pnpm build:packages && pnpm pack:packages:prepared && pnpm verify:packages:browser:prepared",
    "verify:packages:browser:prepared": "node scripts/verifyPackagesBrowser.ts",
    "verify:portability": "pnpm exec vitest run scripts/pnpm-cli.test.ts scripts/release-package-assembly.test.ts && pnpm pack:packages",
    "size:check": "node scripts/check-size.mjs",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release:candidates:check": "node scripts/check-release-candidate-history.ts",
    "release:check": "pnpm verify",
    "release:candidate": "node scripts/release-candidate.ts",
    "release:candidate:prepare": "node scripts/release-candidate.ts",
    "release:candidate:verify": "node scripts/verify-release-candidate.ts",
    "verify": "pnpm release:candidates:check && pnpm format:check && pnpm lint && pnpm build:packages && pnpm typecheck:prepared && pnpm test:unit && pnpm build:apps:prepared && pnpm api:check:prepared && pnpm size:check && pnpm pack:packages:prepared && pnpm verify:packages:prepared && pnpm verify:packages:browser:prepared && pnpm test:e2e && pnpm build:preview:prepared && pnpm test:preview:prepared && pnpm test:fixtures:prepared",
    "clean": "node scripts/clean.mjs"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "catalog:",
    "@axe-core/playwright": "catalog:",
    "@changesets/cli": "catalog:",
    "@microsoft/api-extractor": "catalog:",
    "@playwright/test": "catalog:",
    "@types/node": "catalog:",
    "@vitejs/plugin-vue": "catalog:",
    "@vue/server-renderer": "catalog:",
    "happy-dom": "catalog:",
    "nuxt": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "publint": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "vue": "catalog:",
    "vue-router": "catalog:"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@11.13.1"
}
